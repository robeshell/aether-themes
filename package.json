{
  "name": "aether-themes",
  "version": "0.1.6",
  "description": "An AI-first, template-driven theme kit with swappable CSS themes for customizable personal sites.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/robeshell/aether-themes.git"
  },
  "homepage": "https://github.com/robeshell/aether-themes#readme",
  "bugs": {
    "url": "https://github.com/robeshell/aether-themes/issues"
  },
  "sideEffects": ["**/*.css"],
  "files": [
    "styles",
    "scripts",
    "tools",
    "skills",
    "README.md",
    "README.zh-CN.md",
    "README.ja.md",
    "STARTER_PROMPT.md",
    "SMOKE_TEST_PROMPT.md",
    "UPDATE_PROMPT.md",
    "aether.config.example.mjs",
    "THEME_CONTRACT.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./styles/foundation.css",
    "./foundation.css": "./styles/foundation.css",
    "./all.css": "./styles/all.css",
    "./themes/minimal.css": "./styles/themes/minimal.css",
    "./themes/magazine.css": "./styles/themes/magazine.css",
    "./themes/terminal.css": "./styles/themes/terminal.css",
    "./themes/cyber.css": "./styles/themes/cyber.css",
    "./themes/island.css": "./styles/themes/island.css",
    "./themes/wilds.css": "./styles/themes/wilds.css",
    "./themes/persona.css": "./styles/themes/persona.css",
    "./scripts/persona-titles.js": "./scripts/persona-titles.js",
    "./scripts/markup.js": "./scripts/markup.js"
  },
  "bin": {
    "aether-themes": "tools/generate-theme-css.mjs"
  },
  "keywords": [
    "css",
    "themes",
    "personal-site",
    "astro",
    "design-system",
    "blog",
    "static-site",
    "themeable",
    "eleventy",
    "css-variables",
    "ai-first",
    "template-driven"
  ]
}
